{
  "listen_addr": ":8443",
  "trust_domain": "example.org",
  "cache_skew_seconds": 300,
  "github": {
    "app_id": 123456,
    "installation_id": 789012,
    "private_key_file": "/etc/github-token-broker/app.pem",
    "api_url": "https://api.github.com"
  },
  "policies": [
    {
      "spiffe_id": "spiffe://example.org/agent/opencode",
      "repositories": ["example/repo"],
      "permissions": {
        "contents": "write",
        "pull_requests": "write"
      }
    },
    {
      "spiffe_id": "spiffe://example.org/agent/readonly",
      "repositories": ["example/repo"],
      "permissions": {
        "contents": "read"
      }
    }
  ]
}
